# Clé API Anthropic pour activer l'IA de Marco (côté serveur uniquement, jamais exposée au navigateur).
# Sans clé, Marco fonctionne en mode local (réponses basées sur sa base d'adresses et de rues).
ANTHROPIC_API_KEY=

# Clé Google Maps Platform (API « Places ») pour afficher la photo officielle de chaque lieu sur le vrai site.
# Sans clé, l'app affiche les photos ajoutées par les éditeurs, ou l'illustration Marco.
GOOGLE_MAPS_API_KEY=

# Agent vocal (Vapi, https://vapi.ai) : Marco appelle le restaurant pour réserver à la place du client.
# 1. Créer un compte Vapi, importer un numéro français (Twilio, Vonage ou Telnyx) : les numéros gratuits Vapi n'appellent pas la France.
# 2. Renseigner la clé privée et l'identifiant du numéro. GOOGLE_MAPS_API_KEY est nécessaire pour trouver le numéro du restaurant.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# 1 = l'appel part dès que le client confirme la carte de réservation. Sinon, un éditeur lance l'appel avec le code ci-dessous.
MARCO_AUTO_CALL=
MARCO_ADMIN_TOKEN=
# Facultatif : nombre maximum d'appels par heure, modèle et voix de l'agent.
# MARCO_MAX_CALLS_PER_HOUR=20
# VAPI_MODEL=claude-sonnet-5
# VAPI_VOICE={"provider":"azure","voiceId":"fr-FR-DeniseNeural"}

# Vols et hébergements réservables dans Marco (Duffel, https://duffel.com).
# Jeton de test (duffel_test_…) pour essayer avec la compagnie fictive « Duffel Airways », puis jeton live.
DUFFEL_ACCESS_TOKEN=
# 1 si l'offre hébergement (Duffel Stays) est activée sur ton compte Duffel.
DUFFEL_STAYS=
# 1 pour autoriser la réservation réelle. Le paiement est prélevé sur le solde Duffel de l'entreprise :
# il faut d'abord encaisser le client (Stripe, Duffel Payments…). Sans cette variable, Marco affiche les offres
# en direct mais ne réserve pas.
MARCO_BOOKING=
